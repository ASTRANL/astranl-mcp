+def process_statoids_fifa_row(tr):
+    """Read the row while keeping FIFA footnote markers out of code values."""
+    row = [td.text_content() for td in tr.iterchildren()]
+    if len(row) < 8:
+        return row
+    fifa_cell = copy.deepcopy(tr[7])
+    if row[1] == "GB" and fifa_cell.find(".//a[@href='#note1']") is not None:
+        # The source footnote expands the UK's four separate associations.
+        row[7] = "ENG,NIR,SCO,WAL"
+    else:
+        for anchor in fifa_cell.xpath(".//a[starts-with(@href, '#note')]"):
+            anchor.drop_tree()
+        row[7] = fifa_cell.text_content()
+    return row
+
